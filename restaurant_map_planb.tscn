[sub_resource type="Shader" id="Shader_CaRo"]
code = "shader_type spatial;
render_mode cull_back, diffuse_burley, specular_schlick_ggx;

// San bep ca-ro den trang.
//
// Ve bang SHADER chu khong dan anh texture, vi hai ly do:
//  1. O ca-ro duoc tinh tu TOA DO THE GIOI, nen duong ranh giua cac o luon
//     roi dung x = 0, 2, 4, 6... -- trung khop voi luoi module 2 don vi cua
//     KayKit. Nho vay san bep thanh mot cai THUOC DO: ke tu/bep vao dung mot
//     o ca-ro la chac chan khop luoi, khong phai canh bang mat.
//  2. Doi kich thuoc san hay keo dai khu bep khong lam texture bi keo gian,
//     vi khong co UV nao ca -- o ca-ro van vuong nhu cu.

uniform float o_vuong = 2.0;
uniform vec3 mau_sang : source_color = vec3(0.90, 0.90, 0.88);
uniform vec3 mau_toi : source_color = vec3(0.11, 0.12, 0.12);
uniform float do_nham = 0.85;

varying vec3 vi_tri_the_gioi;

void vertex() {
	vi_tri_the_gioi = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}

void fragment() {
	vec2 o = floor(vi_tri_the_gioi.xz / o_vuong);
	float chan_le = mod(o.x + o.y, 2.0);
	ALBEDO = mix(mau_toi, mau_sang, chan_le);
	ROUGHNESS = do_nham;
	SPECULAR = 0.15;
}
"

